# 复制到服务器 /opt/penmate/.env 后填入真实值，不要提交到 git。

COMPOSE_PROJECT_NAME=penmate
TZ=Asia/Shanghai

# 镜像（CI 推送后会自动打 latest 和 SHA 两个 tag）
BACKEND_IMAGE=ghcr.io/OWNER/REPO/penmate-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/penmate-frontend:latest

# 外部端口（生产环境用 8443，配合 CF 源规则）
FRONTEND_PUBLIC_PORT=8443
CERT_DIR=./certs

# PostgreSQL 18.4
DB_NAME=penmate
DB_USER=penmate
DB_PASS=<openssl rand -base64 32>

# Redis
REDIS_PASS=<openssl rand -base64 32>

# JWT / 加密密钥（各用 openssl rand -base64 32 生成）
JWT_SECRET=<openssl rand -base64 32>
MODEL_KEY_ENCRYPTION_KEY_BASE64=<openssl rand -base64 24>

# S3 兼容存储（必填，后端和 Milvus 共用此服务）
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_PUBLIC_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY=<your-access-key>
STORAGE_SECRET_KEY=<your-secret-key>
STORAGE_BUCKET=penmate
STORAGE_REGION=us-east-1
STORAGE_SECURE=true
STORAGE_PRESIGN_EXPIRE_MINUTES=15

# Milvus — 变量名以 docker-compose.prod.yml 中的引用为准
MILVUS_S3_ADDRESS=s3.example.com
MILVUS_S3_PORT=443
MILVUS_S3_ACCESS_KEY=<your-access-key>
MILVUS_S3_SECRET_KEY=<your-secret-key>
MILVUS_S3_BUCKET=penmate-milvus
MILVUS_S3_USE_SSL=true
MILVUS_S3_ROOT_PATH=milvus
MILVUS_S3_CLOUD_PROVIDER=aws

# 首次启动引导（默认只创建缺失数据；临时设为 true 可按环境变量覆盖）
BOOTSTRAP_RECONCILE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<strong-admin-password>
BOOTSTRAP_MODEL_PROVIDER=openai
BOOTSTRAP_MODEL_BASE_URL=https://api.openai.com
BOOTSTRAP_MODEL_API_KEY=<your-api-key>
BOOTSTRAP_MODEL_NAME=gpt-4o-mini

# JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75
