# 复制到服务器 /opt/penmate/.env 后填入真实值，不要提交到 git。

# 首次部署先运行 bash ./scripts/init-secrets.sh，再填写脚本列出的环境相关配置。
# 尖括号中的内容只是说明，不能原样用于部署。
COMPOSE_PROJECT_NAME=penmate
TZ=Asia/Shanghai

# 镜像（CI 推送后会自动打 latest 和 SHA 两个 tag）
BACKEND_IMAGE=ghcr.io/OWNER/REPO/penmate-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/penmate-frontend:latest

# 外部端口（生产环境用 8443，配合 CF 源规则）
FRONTEND_PUBLIC_PORT=8443
CERT_DIR=./certs

# PostgreSQL 18.4
# DB_PASS 由初始化脚本生成。已有 postgres-data 数据卷时不要直接修改它。
DB_NAME=penmate
DB_USER=penmate
DB_PASS=<openssl rand -base64 32>

# Redis
REDIS_PASS=<openssl rand -base64 32>

# JWT / 加密密钥（各用 openssl rand -base64 32 生成）
JWT_SECRET=<openssl rand -base64 32>
MODEL_KEY_ENCRYPTION_KEY_BASE64=<openssl rand -base64 32>
RATE_LIMIT_KEY_SECRET=<openssl rand -base64 32>
MODEL_ENDPOINT_ADMIN_PRIVATE_HOST_ALLOWLIST=

# S3 兼容存储（必填，用于正文、文档、版本和 Agent 工件）
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_PUBLIC_ENDPOINT=https://s3.example.com
STORAGE_ACCESS_KEY=<your-access-key>
STORAGE_SECRET_KEY=<your-secret-key>
STORAGE_BUCKET=penmate
STORAGE_REGION=us-east-1
STORAGE_SECURE=true
STORAGE_PRESIGN_EXPIRE_MINUTES=15

# 首次启动引导（默认只创建缺失数据；临时设为 true 可按环境变量覆盖）
BOOTSTRAP_RECONCILE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=<strong-admin-password>

# 可选 Chat 系统配置；四项全空表示跳过，填写时必须全部填写
BOOTSTRAP_CHAT_PROVIDER=openai
BOOTSTRAP_CHAT_BASE_URL=https://api.openai.com/v1
BOOTSTRAP_CHAT_API_KEY=<your-chat-api-key>
BOOTSTRAP_CHAT_MODEL_NAME=gpt-4o-mini

# 可选 Embedding 系统配置；四项全空表示跳过，填写时必须全部填写
BOOTSTRAP_EMBEDDING_PROVIDER=openai
BOOTSTRAP_EMBEDDING_BASE_URL=https://api.openai.com/v1
BOOTSTRAP_EMBEDDING_API_KEY=<your-embedding-api-key>
BOOTSTRAP_EMBEDDING_MODEL_NAME=text-embedding-3-small

# JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75
