# Server
SERVER_PORT=8080

# PostgreSQL 18.4
DB_HOST=localhost
DB_PORT=5432
DB_NAME=penmate
DB_USER=postgres
DB_PASS=replace-with-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_DB=0
REDIS_TIMEOUT=3s

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_VHOST=/

# Flyway
FLYWAY_ENABLED=true

# OpenAPI and Swagger
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# JWT (must be changed in production)
JWT_SECRET=replace-with-at-least-32-char-secret
JWT_ISSUER=penmate
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Idempotency
IDEMPOTENCY_KEY_PREFIX=idempotency:
IDEMPOTENCY_TTL_SECONDS=86400

# Object Storage (S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=replace-with-storage-secret
STORAGE_BUCKET=penmate
STORAGE_REGION=us-east-1
STORAGE_SECURE=false
STORAGE_PRESIGN_EXPIRE_MINUTES=15

# Vector DB
VECTOR_PROVIDER=milvus
VECTOR_ENDPOINT=http://localhost:19530
VECTOR_API_KEY=
VECTOR_COLLECTION_PREFIX=penmate_

# Initial system bootstrap
BOOTSTRAP_RECONCILE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
BOOTSTRAP_MODEL_PROVIDER=openai
BOOTSTRAP_MODEL_BASE_URL=https://api.openai.com
BOOTSTRAP_MODEL_API_KEY=replace-with-model-api-key
BOOTSTRAP_MODEL_NAME=gpt-4o-mini

# Security (Base64-encoded AES key, 16/24/32 bytes before Base64)
MODEL_KEY_ENCRYPTION_KEY_BASE64=replace-with-base64-aes-key

# Actuator
HEALTH_SHOW_DETAILS=never

