# Server
SERVER_PORT=8080

# PostgreSQL 18.4
DB_HOST=localhost
DB_PORT=5432
DB_NAME=penmate
DB_USER=postgres
DB_PASS=replace-with-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_DB=0
REDIS_TIMEOUT=3s

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_VHOST=/

# Flyway
FLYWAY_ENABLED=true

# OpenAPI and Swagger
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# JWT (must be changed in production)
JWT_SECRET=replace-with-at-least-32-char-secret
JWT_ISSUER=penmate
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Independent HMAC secret for Redis rate-limit subjects
RATE_LIMIT_KEY_SECRET=replace-with-independent-32-char-secret
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Idempotency
IDEMPOTENCY_KEY_PREFIX=idempotency:
IDEMPOTENCY_TTL_SECONDS=86400

# Object Storage (S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=replace-with-storage-secret
STORAGE_BUCKET=penmate
STORAGE_REGION=us-east-1
STORAGE_SECURE=false
STORAGE_PRESIGN_EXPIRE_MINUTES=15

# Initial system bootstrap
BOOTSTRAP_RECONCILE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password

# Optional Chat bootstrap group (all empty skips; partial groups are invalid)
BOOTSTRAP_CHAT_PROVIDER=openai
BOOTSTRAP_CHAT_BASE_URL=https://api.openai.com/v1
BOOTSTRAP_CHAT_API_KEY=replace-with-chat-api-key
BOOTSTRAP_CHAT_MODEL_NAME=gpt-4o-mini

# Optional Embedding bootstrap group (all empty skips; partial groups are invalid)
BOOTSTRAP_EMBEDDING_PROVIDER=openai
BOOTSTRAP_EMBEDDING_BASE_URL=https://api.openai.com/v1
BOOTSTRAP_EMBEDDING_API_KEY=replace-with-embedding-api-key
BOOTSTRAP_EMBEDDING_MODEL_NAME=text-embedding-3-small

# Embedding dimension probe (one request, no retry)
EMBEDDING_PROBE_CONNECT_TIMEOUT=5s
EMBEDDING_PROBE_RESPONSE_TIMEOUT=15s

# Security (Base64-encoded AES key, 16/24/32 bytes before Base64)
MODEL_KEY_ENCRYPTION_KEY_BASE64=replace-with-base64-aes-key
MODEL_ENDPOINT_ALLOW_PRIVATE=false
MODEL_ENDPOINT_ADMIN_PRIVATE_HOST_ALLOWLIST=

# Actuator
HEALTH_SHOW_DETAILS=never

